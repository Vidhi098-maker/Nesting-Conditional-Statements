# Copy to .env, fill in, then: set -a; . ./.env; set +a; python3 -m birthday_planner.web
# Never commit the real .env or your Apple .p8 key.

ANTHROPIC_API_KEY=

# The address people open (must be https for Apple; http only works for localhost)
PUBLIC_URL=https://plan.example.com

# Google: Cloud console > Google Auth Platform > Clients > Web application
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple: developer.apple.com > Certificates, Identifiers & Profiles
APPLE_CLIENT_ID=          # your Services ID, e.g. com.example.planner.web
APPLE_TEAM_ID=            # 10 characters, shown on your membership page
APPLE_KEY_ID=             # ID of the Sign in with Apple key
APPLE_PRIVATE_KEY_PATH=   # path to the AuthKey_XXXXXXXXXX.p8 file
